# Copy to .env (git-ignored). Real shell env vars take precedence over this file.
# Use different values per checkout/worktree to run several instances at once.
WEB_PORT=4321
API_PORT=8787
# wrangler's debugger port also has to be unique per running instance
INSPECTOR_PORT=9229
# Bind address; docker-compose overrides it with 0.0.0.0
HOST=127.0.0.1
