{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "not-stuck-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "routes": [{ "pattern": "juanjodev.com/api/*", "zone_name": "juanjodev.com" }],
  "vars": {
    "SITE_URL": "https://juanjodev.com",
    "MAIL_FROM": "Juanjo <hello@juanjodev.com>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "not-stuck",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
