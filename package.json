{
  "name": "not-stuck",
  "private": true,
  "workspaces": [
    "apps/*",
    "server/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w server/api",
    "build": "npm run build -w apps/web",
    "test": "npm test -w server/api",
    "check": "npm run check -w apps/web && npm run typecheck -w server/api"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
