---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import portrait from "../assets/juanjo-portrait.png";
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import SubscribeForm from "../components/SubscribeForm.astro";
import { SITE } from "../site";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Draft proof stories; expand with details and metrics as BRAND.md section 3 evolves.
const proof = [
  { name: "Viaboby", summary: "From idea to trending app in Peru, including distribution." },
  { name: "LOCL", summary: "Replaced the engine mid-flight while shipping every week." },
  { name: "Build · Advise", summary: "MVPs from 0 to 1, or fractional CTO support." },
];
---

<Base>
  <section class="hero">
    <div>
      <p class="kicker">{SITE.role}</p>
      <h1>I build products with founders, from idea to <em>real users</em>.</h1>
      <p class="lede">
        I get involved in the business, not just the code. I ask, measure and decide with you, so we make fewer
        mistakes and never get stuck.
      </p>
      <div class="cta-row">
        <a class="btn primary" href={SITE.linkedin}>Book a call</a>
        <a class="btn ghost" href="#work">See my work</a>
      </div>
    </div>
    <Picture
      class="portrait"
      src={portrait}
      alt={`Portrait of ${SITE.name}`}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[320, 480, 640, 900]}
      sizes="(max-width: 760px) 20rem, 24rem"
      loading="eager"
      fetchpriority="high"
    />
  </section>

  <section class="proof" id="work" aria-label="Selected work">
    {
      proof.map((item) => (
        <div>
          <h2>{item.name}</h2>
          <p>{item.summary}</p>
        </div>
      ))
    }
  </section>

  <SubscribeForm />

  <section class="section writing" aria-labelledby="writing-title">
    <h2 id="writing-title">Latest writing</h2>
    <PostList posts={posts} />
    <p><a href="/blog">All writing →</a></p>
  </section>
</Base>
