{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "not-stuck-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "routes": [{ "pattern": "notstuck.dev/api/*", "zone_name": "notstuck.dev" }],
  "vars": {
    "SITE_URL": "https://notstuck.dev",
    "MAIL_FROM": "Juan Jose Leon <hello@notstuck.dev>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "not-stuck",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
