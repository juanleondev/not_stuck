{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "not-stuck-web",
  "compatibility_date": "2026-08-22",
  // The API Worker's juanjodev.com/api/* route runs in front of this custom domain.
  "routes": [{ "pattern": "juanjodev.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
