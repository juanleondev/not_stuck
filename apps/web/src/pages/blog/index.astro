---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { SITE } from "../../site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title={`Writing — ${SITE.name}`} description="Notes on building products with founders: decisions, trade-offs and shipping without getting stuck.">
  <h1>Writing</h1>
  <ul class="tags">
    {tags.map((tag) => <li><a href={`/blog/tag/${tag}`}>#{tag}</a></li>)}
  </ul>
  <PostList posts={posts} />
</Base>
